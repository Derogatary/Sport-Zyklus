{
  "name": "sport-zyklus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zyklus-App fuer Frauen: Sport, Fasten, Ernaehrung, Schlaf, Hormone und Kreativitaet passend zur Zyklusphase.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
